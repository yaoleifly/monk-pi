{
  "name": "monk-pi",
  "version": "0.13.0",
  "description": "Zero-config harness for running Pi Coding Agent with Monk API (monk.party)",
  "type": "module",
  "bin": {
    "monk-pi": "./dist/cli.js",
    "mp": "./dist/cli.js"
  },
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "files": [
    "dist",
    "README.md"
  ],
  "scripts": {
    "build": "tsup",
    "dev": "tsup --watch",
    "start": "node ./dist/cli.js",
    "typecheck": "tsc --noEmit",
    "lint": "tsc --noEmit",
    "test": "npm run build && node --import tsx --test --test-reporter spec test/**/*.test.ts",
    "prepublishOnly": "npm run build"
  },
  "keywords": [
    "monk",
    "pi",
    "coding-agent",
    "llm",
    "ai",
    "harness",
    "cli"
  ],
  "author": "yaoleifly",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/yaoleifly/monk-pi.git"
  },
  "homepage": "https://github.com/yaoleifly/monk-pi#readme",
  "bugs": {
    "url": "https://github.com/yaoleifly/monk-pi/issues"
  },
  "license": "MIT",
  "engines": {
    "node": ">=22.19.0"
  },
  "dependencies": {
    "@earendil-works/pi-coding-agent": "^1.2.0",
    "@inquirer/prompts": "^8.7.3",
    "commander": "^15.0.0",
    "cross-spawn": "^7.0.6",
    "picocolors": "^1.1.1"
  },
  "devDependencies": {
    "@types/cross-spawn": "^6.0.6",
    "@types/node": "^26.6.5",
    "tsup": "^8.5.1",
    "tsx": "^4.23.15",
    "typescript": "^5.9.3"
  }
}
